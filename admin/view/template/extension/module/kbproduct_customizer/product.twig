                <div class="tab-pane" id="tab-sides">
                    {#BOC added for the Image Transparency Fixes by Shivam Bansal on 7-7-2021#}
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="input-width">
                            <span class="label-tooltip" data-toggle="tooltip" data-html="true" title="" data-original-title="{{ help_transparency_status }}">
                                {{ text_transparency_status }}
                            </span>
                        </label>
                        <div class="col-sm-10">
                            <select name="kbproduct[transparency_status]" id="transparency_status" class="form-control">
                                {% if (kbproduct['transparency_status']) %} 
                                    <option value="1" selected="selected">{{ text_non_transparent }}</option>
                                    <option value="0">{{ text_transparent }}</option>
                                {% else %} 
                                    <option value="1">{{ text_non_transparent }}</option>
                                    <option value="0" selected="selected">{{ text_transparent }}</option>
                                {% endif %} 
                            </select>
                        </div>
                    </div>
                    {#EOC added for the Image Transparency Fixes by Shivam Bansal on 7-7-2021#}
                    <div class="error_side_select text-danger"></div>
                    {% for key,side in kbproduct['sides'] %} 
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            <a data-toggle="collapse" href="#slider_{{ key }}_collapse" class="">
                                {% if (side['side_name'][language_id]) %}{{ side['side_name'][language_id] }}{% else %} {{ key }}{% endif %} 
                                <i style="color: red;font-size: 15px;display: none" class="fa fa-exclamation-circle  kbproduct-error-tab{{ key }}"></i>
                            </a>
                        </div>
                        <div class="panel-body collapse" id="slider_{{ key }}_collapse">
                            <div class="form-group">  
                                <label class="col-sm-2 control-label" for="input-width">
                                        {{ text_enable_side }} 
                                </label>  
                                <div class="col-sm-10">
                                    <select name="kbproduct[sides][{{ key }}][enable_side]" id="enable_slider" class="form-control sides-enable">
                                        {% if (kbproduct['sides'][key]['enable_side']) %} 
                                            <option value="1" selected="selected">{{ text_yes }}</option>
                                            <option value="0">{{ text_no }}</option>
                                        {% else %} 
                                            <option value="1">{{ text_yes }}</option>
                                            <option value="0" selected="selected">{{ text_no }}</option>
                                        {% endif %} 
                                    </select>
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label">
                                    {{ text_side_name }} 
                                </label>
                                <div class="col-sm-10">
                                    <ul class="nav nav-tabs error_name_{{ key }}">
                                        {% set i=1 %} {% for language in languages %} 
                                            <li {% if (i == 1) %} {{ "class='active'" }}{% endif %} {% set i = i + 1 %}><a href="#tab-{{ key }}{{ language['name'] }}" data-toggle="tab">{{ language['name'] }}</a></li>
                                        {% endfor %} 
                                    </ul>
                                    <div class="tab-content" style="border-right-width: 1px;padding-left: 20px">
                                        {% set i=1 %} {% for language in languages %} 
                                            <div {% if (i == 1) %} {{ "class='tab-pane active'" }}{% else %} {{ "class='tab-pane'" }}{% endif %} {% set i = i + 1 %} id="tab-{{ key }}{{ language['name'] }}">
                                                <div class="form-group">
                                                    <div class="col-sm-12">
                                                        <input type="text" name="kbproduct[sides][{{ key }}][side_name][{{ language['language_id'] }}]" id="name{{ key }}{{ language['language_id'] }}" class="form-control name" value="{{ kbproduct['sides'][key]['side_name'][language['language_id']] }}" />
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %} 
                                    </div>
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">
                                    {{ text_side_image }} 
                                </label>
                                <div class="col-sm-10">
                                    <div class="col-lg-12" id="logo-images-thumbnails">
                                        <div>
                                            <a href="" id="thumb-image-{{ key }}" data-toggle="image" class="img-thumbnail">
                                                <img src="{{ image_dir_url~kbproduct['sides'][key]['side_image'] }}" style="max-width: 100px;max-height: 100px" alt="" title="" data-placeholder="placeholder" />
                                            </a>
                                            <input type="hidden" name="kbproduct[sides][{{ key }}][side_image]" value="{{ kbproduct['sides'][key]['side_image'] }}" id="image_{{ key }}" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %} 
                </div>
            </div>
        </div>
    </div>
</div> 
<script type="text/javascript">
if($('#allow_image_upload').val() == '1') {
    $('.image-div').show();
} else {
    $('.image-div').hide();
}

if($('#enable_image_filters').val() == '1') {
    $('.filter-div').show();
} else {
    $('.filter-div').hide();
}

$('#allow_image_upload').change(function() {
    if($('#allow_image_upload').val() == '1') {
        $('.image-div').show();
    } else {
        $('.image-div').hide();
    }
});

$('#enable_image_filters').change(function() {
    if($('#enable_image_filters').val() == '1') { 
        $('.filter-div').show();
    } else {
        $('.filter-div').hide();
    }
});

var error_image_size = '{{ error_image_size }}';
var error_price = '{{ error_price }}';
var error_length = '{{ error_length }}';
var error_length_invalid = '{{ error_length_invalid }}';
var error_name = '{{ error_name }}';
var error_empty = '{{ error_empty }}';
var error_image = '{{ error_image }}';

{% if (errors['image_size'] is defined) %} 
    $('.kbproduct-error-tab1').show();
    $('#image_size').parent().parent().addClass("has-error");
    $('#image_size').after('<div class="text-danger">' + error_image_size + '</span>');
{% endif %} 
{% if (errors['image_price'] is defined) %} 
    $('.kbproduct-error-tab1').show();
    $('#image_price').parent().parent().addClass("has-error");
    $('#image_price').after('<div class="text-danger">' + error_price + '</span>');
{% endif %} 
{% if (errors['min_len'] is defined) %} 
    $('.kbproduct-error-tab3').show();
    $('#min_len').parent().parent().addClass("has-error");
    $('#min_len').after('<div class="text-danger">' + error_length + '</span>');
{% endif %} 
{% if (errors['max_len'] is defined) %} 
    $('.kbproduct-error-tab3').show();
    $('#max_len').parent().parent().addClass("has-error");
    $('#max_len').after('<div class="text-danger">' + error_length + '</span>');
{% endif %} 
{% if (errors['length_invalid'] is defined) %} 
    $('.kbproduct-error-tab3').show();
    $('#max_len').parent().parent().addClass("has-error");
    $('#max_len').after('<div class="text-danger">' + error_length_invalid + '</span>');
{% endif %} 
{% if (errors['text_price'] is defined) %} 
    $('.kbproduct-error-tab2').show();
    $('#text_price').parent().parent().addClass("has-error");
    $('#text_price').after('<div class="text-danger">' + error_price + '</span>');
{% endif %} 
{% if (errors['design_price'] is defined) %} 
    $('.kbproduct-error-tab2').show();
    $('#design_price').parent().parent().addClass("has-error");
    $('#design_price').after('<div class="text-danger">' + error_price + '</span>');
{% endif %} 
{% if (errors['qrcode_price'] is defined) %} 
    $('.kbproduct-error-tab2').show();
    $('#qrcode_price').parent().parent().addClass("has-error");
    $('#qrcode_price').after('<div class="text-danger">' + error_price + '</span>');
{% endif %} 
{% if (errors['image_filters'] is defined) %} 
    $('.kbproduct-error-tab1').show();
    $('#image_filters').parent().parent().addClass("has-error");
    $('#image_filters').after('<div class="text-danger">' + error_empty + '</span>');
{% endif %} 
{% if (errors['side_name'] is defined) %} 
 {% for key,value in errors['side_name'] %} 
    $('.kbproduct-error-tab4').show();
    $('.kbproduct-error-tab{{ key }}').show();
    $('.error_name_{{ key }}').before('<div class="text-danger">' + error_name + '</span>');
{% endfor %}{% endif %} 
{% if (errors['side_image'] is defined) %} 
 {% for key,value in errors['side_image'] %} 
    $('.kbproduct-error-tab4').show();
    $('.kbproduct-error-tab{{ key }}').show();
    $('#image_{{ key }}').after('<div class="text-danger">' + error_image + '</span>');
{% endfor %}{% endif %} 
    
$(document).ready(function(){
    $('form').submit(function(e){
        $('.error_side_select').html('');
        $('.kbproduct-error-tab4').hide();
        $('.kbproduct-error-tab').hide();
        if($('#status').val() == '1'){
            var flag = false;
            $('#tab-sides').find('.sides-enable').each(function(){
                if($(this).val() == '1'){
                    flag = true;
                }
            });
            if(flag == false){
                e.preventDefault();
                $('.kbproduct-error-tab4').show();
                $('.kbproduct-error-tab').show();
                $('.error_side_select').html('<div class="text-danger">{{ error_side_select }}</span>');
            }
        } 
    }); 
});
</script>