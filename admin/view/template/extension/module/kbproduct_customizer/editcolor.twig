{{ header }}{{ column_left }} 
<div id="content">
    <script src="view/javascript/kbproduct_customizer/velovalidation.js"></script>
    <script src="view/javascript/kbproduct_customizer/colorpicker.js" type="text/javascript"></script>
    <script type="text/javascript">
        velovalidation.setErrorLanguage({
            empty_field: '{{ error_empty_field }}',
            invalid_color: '{{ invalid_color }}',
            maxchar_color: '{{ maxchar_color }}',
        });
    </script>
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" id="save-button" form="form-product" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %} 
                    <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
                {% endfor %} 
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if (success is defined) %} 
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div id="error_message"></div>
        {% if (error_warning is defined) %} 
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div class="panel panel-default">
            <div class="panel-heading">
                {{ store_switcher }} 
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-product" class="form-horizontal">
                    {{ tabs }} 
                    <input type="hidden" name="id_colors" id="max_sides" value="{{ id_colors }}">
                    <div class="tab-content">
                        <div class="tab-pane active" id="tab-general">
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">{{ text_active }}</label>
                                <div class="col-sm-10">
                                    <select name="enable" id="enable" class="form-control">
                                        {% if (enable) %} 
                                            <option value="1" selected="selected">{{ text_yes }}</option>
                                            <option value="0">{{ text_no }}</option>
                                        {% else %} 
                                            <option value="1">{{ text_yes }}</option>
                                            <option value="0" selected="selected">{{ text_no }}</option>
                                        {% endif %} 
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label" for="input-sort-order">
                                    <font style="color: red;position: relative;line-height: 12px;font-size: 14px;">*</font>
                                    {{ text_color_code }} 
                                </label>
                                <div class="col-lg-9">
                                    <div class="col-lg-2">
                                        <div class="row">
                                            <div class="input-group" id="color_3_div">
                                                <input type="text" data-hex="true" value="{{ color }}" class="mColorPicker form-control" name="color"  id="color" style="background-color: {{ color }}; color: white;">
                                                <span style="cursor:pointer;" id="icp_color" class="mColorPickerTrigger input-group-addon" data-mcolorpicker="true">
                                                    <img src="view/image/kbproduct_customizer/color.png" style="border:0;margin:0 0 0 3px" align="absmiddle">
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var allColors = JSON.parse('{{ all_colors }}');
        $('form').submit(function (e) {
            e.preventDefault();
            var error = false;
            var result;
            $(".has-error").removeClass("has-error");
            $(".velsof-has-error").removeClass("velsof-has-error");
            $(".text-danger").remove();

            if (jQuery.inArray($('.mColorPicker').val(), allColors) != '-1') {
                error = true;
                $(".mColorPicker").parent().parent().parent().parent().parent().addClass("has-error");
                $(".mColorPicker").parent().after('<div class="text-danger">{{ duplicate_color }}</span>');
            }
            var result = velovalidation.checkMandatory($(".mColorPicker"));
            if (result != true) {
                error = true;
                $(".mColorPicker").parent().parent().parent().parent().parent().addClass("has-error");
                $(".mColorPicker").parent().after('<div class="text-danger">' + result + '</span>');
            } else {
                result = velovalidation.isColor($(".mColorPicker"));
                if (result != true) {
                    error = true;
                    $(".mColorPicker").parent().parent().addClass("has-error");
                    $(".mColorPicker").parent().after('<div class="text-danger">' + result + '</span>');
                }
            }
            if (error == false) {
                $(this).unbind('submit').submit();
                return true;
            }
        });
    });
</script> 
{{ footer }} 
