{{ header }}{{ column_left }} 
<div id="content">
    <script src="view/javascript/kbproduct_customizer/velovalidation.js"></script>
    <script type="text/javascript">
        velovalidation.setErrorLanguage({
            empty_field: '{{ error_empty_field }}',
            positive_amount: '{{ positive_amount }}',
            valid_amount: '{{ valid_amount }}',
        });
    </script>
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" id="save-button" form="form-product" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %} 
                    <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
                {% endfor %} 
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if (success is defined) %} 
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div id="error_message"></div>

        {% if (error_warning is defined) %} 
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div class="panel panel-default">
            <div class="panel-heading">
                {{ store_switcher }} 
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-product" class="form-horizontal">
                    {{ tabs }} 
                    <input type="hidden" name="image_id" id="max_sides" value="{{ image_id }}">
                    <input type="hidden" name="group_id" id="max_sides" value="{{ group_id }}">
                    <div class="tab-content">
                        <div class="tab-pane active" id="tab-general">
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">
                                    {{ text_upload_image }} 
                                </label>
                                <div class="col-sm-10">
                                    <div class="col-lg-12" id="logo-images-thumbnails">
                                        <div>
                                            <a href="" id="thumb-image" data-toggle="image" class="img-thumbnail">
                                                <img src="{{ image_dir_url ~ image }}" style="max-width: 100px;max-height: 100px" alt="" title="" data-placeholder="placeholder" />
                                            </a>
                                            <input type="hidden" name="image" value="{{ image }}" id="image" />
                                            <p style="font-weight: 100; font-style: italic">{{ text_img_hint }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">
                                    {{ text_price }} 
                                </label>
                                <div class="col-sm-10">
                                    <input name="price" class="form-control" id="price" value="{{ price }}">
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">{{ text_active }}</label>
                                <div class="col-sm-10">
                                    <select name="enable" id="enable" class="form-control">
                                        {% if (enable) %} 
                                            <option value="1" selected="selected">{{ text_yes }}</option>
                                            <option value="0">{{ text_no }}</option>
                                        {% else %} 
                                            <option value="1">{{ text_yes }}</option>
                                            <option value="0" selected="selected">{{ text_no }}</option>
                                        {% endif %} 
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('form').submit(function (e) {
            e.preventDefault();
            var error = false;
            var result;
            $(".has-error").removeClass("has-error");
            $(".velsof-has-error").removeClass("velsof-has-error");
            $(".text-danger").remove();

            var result = velovalidation.checkMandatory($("#image"));
            if (result != true) {
                error = true;
                $("#image").parent().parent().addClass("has-error");
                $("#image").after('<div class="text-danger">' + result + '</span>');
            }

            var result = velovalidation.checkMandatory($("#price"));
            if (result != true) {
                error = true;
                $("#price").parent().parent().addClass("has-error");
                $("#price").after('<div class="text-danger">' + result + '</span>');
            } else {
                var result = velovalidation.checkAmount($("#price"));
                if (result != true) {
                    error = true;
                    $("#price").parent().parent().addClass("has-error");
                    $("#price").after('<div class="text-danger">' + result + '</span>');
                }
            }

            if (error == false) {
                $(this).unbind('submit').submit();
                return true;
            }
        });
    });
</script> 
{{ footer }} 
