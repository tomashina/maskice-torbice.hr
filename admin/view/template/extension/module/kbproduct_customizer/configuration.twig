{{ header }}{{ column_left }} 
<div id="content">
    <script src="view/javascript/kbproduct_customizer/velovalidation.js"></script>
    <script type="text/javascript">
        velovalidation.setErrorLanguage({
            empty_field: '{{ error_empty_field }}',
            positive_number: '{{ error_positive_number }}',
            number_field: '{{ error_number_field }}',
        });
    </script>
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" id="save-button" form="form-product" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %} 
                    <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
                {% endfor %} 
            </ul>
            {% if (success is defined) %} 
                <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }} 
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            {% endif %} 
            <div id="error_message"></div>
        </div>
    </div>
    <div class="container-fluid">
        {% if (error_warning is defined) %} 
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div class="panel panel-default">
            <div class="panel-heading">
                {{ store_switcher }} 
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-product" class="form-horizontal">
                    {{ tabs }} 
                    <div class="tab-content">
                        <div class="tab-pane active" id="tab-general">
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">{{ text_enable }}</label>
                                <div class="col-sm-10">
                                    <select name="kbproduct_customizer[enable]" id="enable" class="form-control">
                                        {% if (kbproduct_customizer['enable']) %} 
                                            <option value="1" selected="selected">{{ text_enable_status }}</option>
                                            <option value="0">{{ text_disable_status }}</option>
                                        {% else %} 
                                            <option value="1">{{ text_enable_status }}</option>
                                            <option value="0" selected="selected">{{ text_disable_status }}</option>
                                        {% endif %} 
                                    </select>
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">
                                    <span data-toggle="tooltip" title="{{ text_max_sides_tooltip }}">
                                        {{ text_max_sides }} 
                                    </span>
                                </label>
                                <div class="col-sm-10">
                                    <input name="kbproduct_customizer[max_sides]" class="form-control" id="max_sides" value="{{ kbproduct_customizer['max_sides'] }}">
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {

        $('form').submit(function (e) {
            e.preventDefault();
            var error = false;
            var result;
            $(".has-error").removeClass("has-error");
            $(".velsof-has-error").removeClass("velsof-has-error");
            $(".text-danger").remove();

            var result = velovalidation.checkMandatory($("#max_sides"));
            if (result != true) {
                error = true;
                $("#max_sides").parent().parent().addClass("has-error");
                $("#max_sides").after('<div class="text-danger">' + result + '</span>');
            } else {
                result = velovalidation.isPositiveNumber($("#max_sides"));
                if (result != true) {
                    error = true;
                    $("#max_sides").parent().parent().addClass("has-error");
                    $("#max_sides").after('<div class="text-danger">' + result + '</span>');
                } else if ($("#max_sides").val() > 10) {
                    error = true;
                    $("#max_sides").parent().parent().addClass("has-error");
                    $("#max_sides").after('<div class="text-danger">{{ error_max_side_limit }}</span>');
                }
            }

            if (error == false) {
                $(this).unbind('submit').submit();
                return true;
            }
        });
    });
</script> 
{{ footer }} 
