{{ header }}{{ column_left }} 
<div id="content">
    <script src="view/javascript/kbproduct_customizer/velovalidation.js"></script>
    <script type="text/javascript">
        velovalidation.setErrorLanguage({
            empty_field: '{{ error_empty_field }}',
        });
    </script>
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" id="save-button" form="form-product" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %} 
                    <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
                {% endfor %} 
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if (success is defined) %} 
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div id="error_message"></div>
        {% if (error_warning is defined) %} 
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div class="panel panel-default">
            <div class="panel-heading">
                {{ store_switcher }} 
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-product" class="form-horizontal">
                    {{ tabs }} 
                    <input type="hidden" name="id_fonts" id="max_sides" value="{{ id_fonts }}">
                    <div class="tab-content">
                        <div class="tab-pane active" id="tab-general">
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">{{ text_active }}</label>
                                <div class="col-sm-10">
                                    <select name="enable" id="enable" class="form-control">
                                        {% if (enable) %} 
                                            <option value="1" selected="selected">{{ text_yes }}</option>
                                            <option value="0">{{ text_no }}</option>
                                        {% else %} 
                                            <option value="1">{{ text_yes }}</option>
                                            <option value="0" selected="selected">{{ text_no }}</option>
                                        {% endif %} 
                                    </select>
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">
                                    <span data-toggle="tooltip" title="{{ text_font_title_tooltip }}">
                                        {{ text_font_title }} 
                                    </span>
                                </label>
                                <div class="col-sm-10">
                                    <input name="title" class="form-control" id="title" value="{{ title }}">
                                    <p style="font-style: italic;color:#959595;">{{ fonts_hint1 }}</p>
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">
                                    <span data-toggle="tooltip" title="{{ text_embed_font_tooltip }}">
                                        {{ text_embed_font }} 
                                    </span>
                                </label>
                                <div class="col-sm-10">
                                    <input name="font_url" class="form-control" id="font_url" value="{{ font_url }}">
                                    <p style="font-style: italic;color:#959595;">{{ fonts_hint2 }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var allFonts_name = JSON.parse('{{ all_fonts_name }}');
        var allFonts_url = JSON.parse('{{ all_fonts_url }}');

        $('form').submit(function (e) {
            e.preventDefault();
            var error = false;
            var result;
            $(".has-error").removeClass("has-error");
            $(".velsof-has-error").removeClass("velsof-has-error");
            $(".text-danger").remove();

            if (jQuery.inArray($('#title').val(), allFonts_name) != '-1') {
                error = true;
                $("#title").parent().parent().addClass("has-error");
                $("#title").after('<div class="text-danger">{{ duplicate_font_name }}</span>');
            } else {
                if (jQuery.inArray($('#font_url').val(), allFonts_url) != '-1') {
                    error = true;
                    $("#font_url").parent().parent().addClass("has-error");
                    $("#font_url").after('<div class="text-danger">{{ duplicate_font_url }}</span>');
                }
            }
            var result = velovalidation.checkMandatory($("#title"));
            if (result != true) {
                error = true;
                $("#title").parent().parent().addClass("has-error");
                $("#title").after('<div class="text-danger">' + result + '</span>');
            }
            var result = velovalidation.checkMandatory($("#font_url"));
            if (result != true) {
                error = true;
                $("#font_url").parent().parent().addClass("has-error");
                $("#font_url").after('<div class="text-danger">' + result + '</span>');
            }

            if (error == false) {
                $(this).unbind('submit').submit();
                return true;
            }
        });
    });
</script> 
{{ footer }} 
