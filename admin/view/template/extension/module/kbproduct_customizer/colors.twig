{{ header }}{{ column_left }} 
<div id="content">
    <style>
        .kb_td_color_block {
            border: 1px solid #cecece;
            padding: 2px;
            width: 30%;
        }
        .kb_td_color_block .kb_td_color {
            height: 20px;
        }
    </style>
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <a href="{{ editColor_url }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %} 
                    <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
                {% endfor %} 
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if (success is defined) %} 
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div id="error_message"></div>
        {% if (error_warning is defined) %} 
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div class="panel panel-default">
            <div class="panel-heading">
                {{ store_switcher }} 
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                {{ tabs }} 
                <div class="well" style="display: none">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="form-group">
                                <label class="control-label" for="input-status">{{ text_active }}</label>
                                <select name="filter_status" id="filter_status" class="form-control">
                                    <option value=""></option>
                                    {% if (filter_status) %} 
                                        <option value="1" selected="selected">{{ text_yes }}</option>
                                    {% else %} 
                                        <option value="1">{{ text_yes }}</option>
                                    {% endif %} 
                                    {% if (not filter_status and filter_status is not null) %} 
                                        <option value="0" selected="selected">{{ text_no }}</option>
                                    {% else %} 
                                        <option value="0">{{ text_no }}</option>
                                    {% endif %} 
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="form-group">
                                <div class="control-label">&nbsp;</div>
                                <button type="button" id="button-reset" name="reset" value="reset" class="btn btn-default">
                                    {{ button_reset }} 
                                </button>
                                <button type="button" id="button-filter" class="btn btn-primary"><i class="fa fa-filter"></i> {{ button_filter }}</button>
                            </div>
                        </div>
                    </div>
                </div>
                <table class="table table-bordered table-hover">
                    <thead>
                        <td class="text-left" style="width: 50px">
                            {% if (sort == 'id') %} 
                                <a href="{{ sort_id }}" class="{{ order }}">{{ text_id }}</a>
                            {% else %} 
                                <a href="{{ sort_id }}">{{ text_id }}</a>
                            {% endif %} 
                        </td>
                        <th>{{ text_code }}</th>
                        <td class="text-center" style="width: 125px">
                            {% if (sort == 'status') %} 
                                <a href="{{ sort_status }}" class="{{ order }}">{{ text_active }}</a>
                            {% else %} 
                                <a href="{{ sort_status }}">{{ text_active }}</a>
                            {% endif %} 
                        </td>
                        <td class="text-center" style="width: 125px">
                            {% if (sort == 'date_add') %} 
                            <a href="{{ sort_date_add }}" class="{{ order }}">{{ text_date_add }}</a>
                            {% else %} 
                            <a href="{{ sort_date_add }}">{{ text_date_add }}</a>
                            {% endif %} 
                        </td>
                        <th style="text-align: right; width: 120px">{{ text_action }}</th>
                    </thead>
                    <tbody>
                        {% for key,value in colors_data %} 
                            <tr>
                                <td>{{ value['id'] }}</td>
                                <td style="text-align: center">
                                    <div class="kb_td_color_block">
                                        <div class="kb_td_color" style="background:{{ value['color'] }}"></div>
                                    </div>
                                </td>
                                <td  style="text-align: center">{{ value['status_text'] }}</td>
                                <td  style="text-align: center">{{ value['date_add'] }}</td>
                                <td style="text-align: right">
                                    <a href="{{ editColor_url ~ '&color_id=' ~ value['id'] }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
                                    <a href="{{ deleteColor_url ~ '&id=' ~ value['id'] }}" onclick="return confirm('{{ text_are_you_sure }}')" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger"><i class="fa fa-trash"></i></a>
                                </td>
                            </tr>
                        {% endfor %} 
                    </tbody>
                </table>
                <div class="row">
                    <div class="col-sm-6 text-left">{{ pagination }}</div>
                    <div class="col-sm-6 text-right">{{ results }}</div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $('#button-filter').on('click', function () {
        var url = '{{ current_url }}';

        var filter_status = $('#filter_status').val();
        if (filter_status) {
            url += '&filter_status=' + encodeURIComponent(filter_status);
        }
        location = url;
    });

    $('#button-reset').on('click', function () {
        var url = '{{ current_url }}';
        location = url;
    });
</script>
{{ footer }} 
