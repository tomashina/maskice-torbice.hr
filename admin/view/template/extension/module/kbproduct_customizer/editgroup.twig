{{ header }}{{ column_left }} 
<div id="content">
    <script src="view/javascript/kbproduct_customizer/velovalidation.js"></script>
    <script type="text/javascript">
        var error_empty_lang = '{{ error_empty_lang }}';
        velovalidation.setErrorLanguage({
            empty_field: '{{ error_empty_field }}',
        });
    </script>
    <div class="page-header">
        <div class="container-fluid">
            <div class="pull-right">
                <button type="submit" id="save-button" form="form-product" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
                <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %} 
                    <li><a href="{{ breadcrumb['href'] }}">{{ breadcrumb['text'] }}</a></li>
                {% endfor %} 
            </ul>
        </div>
    </div>
    <div class="container-fluid">
        {% if (success is defined) %} 
            <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div id="error_message"></div>
        {% if (error_warning is defined) %} 
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }} 
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        {% endif %} 
        <div class="panel panel-default">
            <div class="panel-heading">
                {{ store_switcher }} 
                <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
            </div>
            <div class="panel-body">
                <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-product" class="form-horizontal">
                    {{ tabs }} 
                    <input type="hidden" name="group_id" id="max_sides" value="{{ group_id }}">
                    <div class="tab-content">
                        <div class="tab-pane active" id="tab-general">
                            <div class="form-group">
                                <label class="col-sm-2 control-label"><font style="color: red">*</font> 
                                    {{ text_image_group_name }} 
                                </label>
                                <div class="col-sm-10">
                                    <ul class="nav nav-tabs error-name">
                                        {% set i = 1 %}
 {% for language in languages %} 
                                            <li {% if (i == 1) %}
 {{ "class='active'" }}
 {% endif %} {% set i = i + 1 %}><a href="#btitle1-tab-{{ language['name'] }}" data-toggle="tab">{{ language['name'] }}</a></li>
                                        {% endfor %} 
                                    </ul>
                                    <div class="tab-content" style="border-right-width: 1px;padding-left: 20px">
                                        {% set i = 1 %}
 {% for language in languages %} 
                                            <div {% if (i == 1) %} {{ "class='tab-pane active'" }} {% else %} {{ "class='tab-pane'" }} {% endif %} {% set i = i + 1 %} id="btitle1-tab-{{ language['name'] }}">
                                                <div class="form-group">
                                                    <div class="col-sm-12">
                                                        <input type="text" name="name[{{ language['language_id'] }}]" id="btitle1{{ language['language_id'] }}" class="form-control name" value="{{ name[language['language_id']] }}" />
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %} 
                                    </div>
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">{{ text_upload_image }}</label>
                                <div class="col-sm-10">
                                    <div class="col-lg-12" id="logo-images-thumbnails">
                                        <div>
                                            <a href="javascript://" id="thumb-image" data-toggle="image" class="img-thumbnail">
                                                <img src="{{ image_dir_url ~ image }}" style="max-width: 100px;max-height: 100px" alt="" title="" data-placeholder="placeholder" />
                                            </a>
                                            <input type="hidden" name="image" value="{{ image }}" id="image" />
                                            <p style="font-weight: 100; font-style: italic">{{ text_img_hint }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group required">
                                <label class="col-sm-2 control-label" for="input-status">{{ text_active }}</label>
                                <div class="col-sm-10">
                                    <select name="enable" id="enable" class="form-control">
                                        {% if (enable) %} 
                                            <option value="1" selected="selected">{{ text_yes }}</option>
                                            <option value="0">{{ text_no }}</option>
                                        {% else %} 
                                            <option value="1">{{ text_yes }}</option>
                                            <option value="0" selected="selected">{{ text_no }}</option>
                                        {% endif %} 
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {

        $('form').submit(function (e) {
            e.preventDefault();
            var error = false;
            var result;
            $(".has-error").removeClass("has-error");
            $(".velsof-has-error").removeClass("velsof-has-error");
            $(".text-danger").remove();

            $('.name').each(function () {
                var result = velovalidation.checkMandatory($(this));
                if (result != true) {
                    $(".text-danger").remove();
                    error = true;
                    $(this).parent().parent().addClass("has-error");
                    $('.error-name').before('<div class="text-danger">' + error_empty_lang + '</span>');
                }
            });
            var result = velovalidation.checkMandatory($("#image"));
            if (result != true) {
                error = true;
                $("#image").parent().parent().addClass("has-error");
                $("#image").after('<div class="text-danger">' + result + '</span>');
            }

            if (error == false) {
                $(this).unbind('submit').submit();
                return true;
            }
        });
    });
</script> 
{{ footer }} 
